# OpenRouter configuration for run_bio_llm.py — copy to llm/.env and fill in.
# Field names map to llm_judge.settings.Settings (pydantic-settings, case-insensitive).

base_url=https://openrouter.ai/api/v1
token=sk-or-...
model=google/gemini-2.5-pro

# Simultaneous API calls. The retrieval tasks send the whole corpus per query
# (~35-50k tokens each); lower this if you hit provider rate limits.
max_concurrency=5

# For reasoning models only (Gemini, o-series/gpt-5, etc.): low | medium | high.
# Leave unset for non-reasoning models. enable_thinking=false disables thinking.
# reasoning_effort=medium

# Gemini/Groq don't accept strict json_schema response_format:
# use_strict_json=false

# Planned model set (OpenRouter ids), one pass each:
#   frontier reasoning:      google/gemini-2.5-pro
#   cheap reasoning:         openai/gpt-5-mini
#   non-reasoning baseline:  openai/gpt-4.1-mini
#   open MoE:                qwen/qwen3-235b-a22b
