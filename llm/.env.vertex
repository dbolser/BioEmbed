# Vertex AI (paper-faithful Gemini path: ADC token refresh, cached input at 10%).
# Copy to .env when running Gemini via Vertex. token is unused with use_vertex_ai.
token=vertex
use_vertex_ai=true
base_url=https://aiplatform.googleapis.com/v1/projects/agentic-ai-iuk-ipf/locations/global/endpoints/openapi
model=google/gemini-3.1-pro-preview
use_strict_json=false
max_concurrency=5
